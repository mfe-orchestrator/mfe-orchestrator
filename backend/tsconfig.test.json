{
    /* Type checks the unit tests, which tsconfig.json leaves out of the build so they
       never reach dist. Checking only, nothing is emitted from here. */
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true
    },
    "include": ["src/**/*.ts", "src/types/**/*.d.ts"],
    "exclude": []
}
