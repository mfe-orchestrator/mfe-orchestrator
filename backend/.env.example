NOSQL_DATABASE_URL=mongodb://localhost:27018/admin
NOSQL_DATABASE_NAME=mfe-orchestrator
NOSQL_DATABASE_USERNAME=root
NOSQL_DATABASE_PASSWORD=example
REDIS_URL=redis://localhost:6380

REGISTRATION_ALLOWED=true
ALLOW_EMBEDDED_LOGIN=true

# Richieste per IP al minuto. Se non impostata vale 100: sufficiente per l'uso
# normale, stretta per una suite e2e, dove ogni navigazione della SPA fa partire
# un gruppo di chiamate e il tetto salta con un 429.
# Lasciarla commentata se non serve: valorizzata a vuoto non supera lo schema.
# RATE_LIMIT_MAX=300

# Cifra a riposo le credenziali che la console conserva per un progetto: chiavi
# dei bucket, connection string, token dei repository. 32 byte, base64 o hex:
# openssl rand -base64 32
# Non impostata, quei valori restano in chiaro come prima. Vedi docs/SECRETS.md.
SECRETS_ENCRYPTION_KEY=

CODE_REPOSITORY_GITHUB_CLIENT_ID=
CODE_REPOSITORY_GITHUB_CLIENT_SECRET=

NODE_ENV=development

# Invio email tramite SMTP reale. Senza EMAIL_SMTP_HOST la app non manda email:
# registrazione e inviti diventano immediati e i test e2e che seguono i link
# ricevuti si auto-escludono. Il reset della password invece non ha nulla in cui
# degradare, perche' esiste solo come link in una email: senza SMTP viene
# rifiutato subito con EMAIL_NOT_CONFIGURED, e l'unico modo di rientrare in un
# account e' che un amministratore ne cambi la password sul database.
# I test e2e leggono le caselle su testmail.app, quindi la posta deve poter
# uscire davvero verso inbox.testmail.app.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=no-reply@mfe-orchestrator.dev

# Origine usata nei link inviati per email (attivazione account, invito a un progetto)
FRONTEND_URL=http://localhost:5173

MICROFRONTEND_HOST_FOLDER=/path/to/microfrontends