{
    "name": "@mfe-orchestrator/backend",
    "version": "1.0.0",
    "description": "Backend service for micro-frontend orchestrator",
    "main": "index.js",
    "scripts": {
        "start": "nodemon --exec tsx ./src/index.ts",
        "st": "tsx ./src/index.ts",
        "dev": "pnpm run start",
        "build": "tsc && node ./postbuild.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome lint --write ./src",
        "format": "biome format --write ./src",
        "typecheck": "pnpm exec tsc --noEmit && pnpm exec tsc --noEmit -p tsconfig.test.json"
    },
    "keywords": [],
    "author": "",
    "license": "Apache-2.0",
    "packageManager": "pnpm@10.19.0",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1107.0",
        "@aws-sdk/s3-request-presigner": "^3.1107.0",
        "@azure/identity": "^4.13.1",
        "@azure/storage-blob": "^12.33.0",
        "@fastify/autoload": "^6.5.0",
        "@fastify/cors": "^11.3.0",
        "@fastify/env": "^7.0.0",
        "@fastify/helmet": "^13.1.0",
        "@fastify/multipart": "^10.1.0",
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/sensible": "^6.0.5",
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^6.1.1",
        "@google-cloud/storage": "^7.22.0",
        "@redis/client": "^6.2.1",
        "@sentry/node": "^10.70.0",
        "adm-zip": "^0.6.0",
        "axios": "^1.19.0",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "fastify": "^5.11.3",
        "fastify-auth0-verify": "^4.1.3",
        "fastify-plugin": "^6.0.0",
        "fs-extra": "^11.4.0",
        "isomorphic-git": "^1.41.3",
        "jsonwebtoken": "^9.0.3",
        "libsodium-wrappers": "^0.8.4",
        "mongoose": "^9.9.2",
        "nodemailer": "^9.0.5",
        "nodemon": "^3.1.14",
        "pug": "^3.0.4",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.67.0",
        "xstate": "^5.32.5"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/fs-extra": "^11.0.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.2.0",
        "@types/nodemailer": "^8.0.1",
        "@types/pug": "^2.0.10",
        "tsx": "^4.23.12",
        "vitest": "^4.1.10"
    }
}
