        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.0",
        "xstate": "^5.33.3",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/fs-extra": "^11.0.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mssql": "^12.3.0",
        "@types/node": "^26.6.5",
        "@types/nodemailer": "^8.0.2",
        "@types/oracledb": "^7.0.3",
        "@types/pg": "^8.23.1",
