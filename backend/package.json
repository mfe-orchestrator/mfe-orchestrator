{
    "name": "@mfe-orchestrator/backend",
    "version": "1.0.0",
    "description": "Backend service for micro-frontend orchestrator",
    "main": "index.js",
    "scripts": {
        "start": "nodemon --watch src --ext ts,json --exec tsx ./src/index.ts",
        "st": "tsx ./src/index.ts",
        "dev": "pnpm run start",
        "build": "tsc && node ./postbuild.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome lint --write ./src",
        "format": "biome format --write ./src",
        "docs:index": "node ./scripts/build-docs-index.js",
        "typecheck": "pnpm exec tsc --noEmit && pnpm exec tsc --noEmit -p tsconfig.test.json"
    },
    "keywords": [],
    "author": "",
    "license": "Apache-2.0",
    "packageManager": "pnpm@10.19.0",
    "dependencies": {
        "@anthropic-ai/foundry-sdk": "^0.5.4",
        "@anthropic-ai/sdk": "^0.131.0",
        "@aws-sdk/client-s3": "^3.1154.0",
        "@aws-sdk/s3-request-presigner": "^3.1154.0",
        "@azure/identity": "^4.14.0",
        "@azure/storage-blob": "^12.34.0",
        "@fastify/autoload": "^6.5.1",
        "@fastify/cors": "^11.3.1",
        "@fastify/env": "^7.0.1",
        "@fastify/helmet": "^13.2.0",
        "@fastify/multipart": "^10.1.4",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/sensible": "^6.0.7",
        "@fastify/swagger": "^9.9.2",
        "@fastify/swagger-ui": "^6.1.2",
        "@google-cloud/storage": "^7.22.0",
        "@google/genai": "^2.30.0",
        "@modelcontextprotocol/node": "2.1.1",
        "@modelcontextprotocol/server": "2.3.1",
        "@redis/client": "^6.3.0",
        "@sentry/node": "^10.70.0",
        "adm-zip": "^0.6.1",
        "axios": "^1.20.0",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "fastify": "^5.12.7",
        "fastify-auth0-verify": "^4.1.4",
        "fastify-plugin": "^6.0.1",
        "fs-extra": "^11.4.1",
        "isomorphic-git": "^1.44.3",
        "jose": "6.2.13",
        "jsonwebtoken": "^9.0.3",
        "libsodium-wrappers": "^0.8.4",
